{
  "name": "miao-chemistry",
  "productName": "miao-chemistry",
  "version": "1.0.0",
  "description": "Miao积分管理",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "cross-env BUILD_TYPE=trial DURATION=7 electron-forge start",
    "start:official": "cross-env BUILD_TYPE=official electron-forge start",
    "package": "cross-env BUILD_TYPE=trial electron-forge package",
    "build:basic-all": "cross-env BUILD_TYPE=trial DURATION=7 electron-forge make --platform=win32,darwin",
    "build:basic-mac": "cross-env BUILD_TYPE=trial DURATION=7 electron-forge make --platform=darwin",
    "build:basic-win": "cross-env BUILD_TYPE=trial DURATION=7 electron-forge make --platform=win32",
    "build:trial-all": "cross-env BUILD_TYPE=trial DURATION=30 electron-forge make --platform=win32,darwin",
    "build:trial-mac": "cross-env BUILD_TYPE=trial DURATION=30 electron-forge make --platform=darwin",
    "build:trial-win": "cross-env BUILD_TYPE=trial DURATION=30 electron-forge make --platform=win32",
    "build:official-all": "cross-env BUILD_TYPE=official electron-forge make --platform=win32,darwin",
    "build:official-mac": "cross-env BUILD_TYPE=official electron-forge make --platform=darwin",
    "build:official-win": "cross-env BUILD_TYPE=official electron-forge make --platform=win32"
  },
  "keywords": [],
  "author": {
    "name": "chunlei.wang",
    "email": "lei021101@163.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-wix": "^7.0.0",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^25.9.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "class-variance-authority": "^0.7.1",
    "cross-env": "^10.1.0",
    "electron": "39.2.6",
    "sass-embedded": "^1.96.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tailwindcss/vite": "^4.1.18",
    "@vueuse/core": "^14.1.0",
    "blueimp-md5": "^2.19.0",
    "browser-image-compression": "^2.0.2",
    "echarts": "^6.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "element-plus": "^2.12.0",
    "html-to-docx": "^1.8.0",
    "marked": "^12.0.2",
    "motion-v": "^1.7.4",
    "pinia": "^3.0.4",
    "postprocessing": "^6.38.0",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.1.18",
    "uuid": "^13.0.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "vue3-image-editor": "^1.1.1",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5"
